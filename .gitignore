# --- R session / RStudio ----------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.DS_Store
package-build-and-install-script.R

# --- Compiled C++ / shared objects (Rcpp) ------------------------------
src/*.o
src/*.so
src/*.dll
src/*.rds
src/symbols.rds

